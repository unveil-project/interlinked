{
  "name": "interlinked-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @unveil/interlinked build",
    "dev": "pnpm build && pnpm --parallel --filter @unveil/interlinked --filter site dev",
    "dev:site": "pnpm --filter site dev",
    "build:site": "pnpm build && pnpm --filter site build",
    "test": "pnpm --filter @unveil/interlinked test",
    "typecheck": "pnpm --filter @unveil/interlinked typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint:fix && pnpm format"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10"
  }
}
