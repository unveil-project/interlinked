{
	"name": "@unveil/interlinked",
	"type": "module",
	"version": "0.0.4",
	"description": "Detect AI-agent-written PR descriptions",
	"author": "Matteo Gabriele <m.gabriele.dev@gmail.com>",
	"license": "MIT",
	"homepage": "https://github.com/unveil-project/interlinked#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/unveil-project/interlinked.git"
	},
	"bugs": {
		"url": "https://github.com/unveil-project/interlinked/issues"
	},
	"exports": {
		".": "./dist/index.mjs",
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"build:userscript": "tsdown -c userscript/tsdown.config.ts",
		"dev:userscript": "tsdown -c userscript/tsdown.config.ts --watch",
		"test": "vitest",
		"test:regression": "vitest run tests/regression.test.ts --reporter=verbose",
		"test:regression:update": "UPDATE_BASELINE=1 vitest run tests/regression.test.ts",
		"typecheck": "tsc --noEmit && tsc --noEmit -p userscript",
		"check": "biome check --write",
		"release": "bumpp",
		"prepublishOnly": "pnpm run test:regression && pnpm run build"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/node": "^26.1.1",
		"bumpp": "^11.1.0",
		"tsdown": "^0.22.5",
		"tsx": "^4.19.2",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
